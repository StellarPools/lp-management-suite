# LP Suite Keeper — environment variables
# Copy to .env and fill in real values before running.

# Required: deployed aggregator contract ID
LP_SUITE_CONTRACT_ID=CA...

# Required: Soroban RPC endpoint
LP_SUITE_RPC_URL=https://soroban-testnet.stellar.org

# Required: keeper's Stellar account public key (pays tx fees for compound calls)
LP_SUITE_KEEPER_ACCOUNT=G...

# Required: keeper's Stellar account secret key (used to sign compound() calls)
# Keep this secret — never commit a real value to source control.
LP_SUITE_KEEPER_PRIVATE_KEY=S...

# Optional: poll interval in milliseconds (default: 300000 = 5 minutes)
LP_SUITE_KEEPER_POLL_INTERVAL_MS=300000

# Optional: webhook URL to forward health alerts to (e.g. Slack incoming webhook)
LP_SUITE_ALERT_WEBHOOK=

# Optional: log level (debug | info | warn | error, default: info)
LP_SUITE_LOG_LEVEL=info
