{
  "name": "@lp-suite/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for LP Management Suite on Stellar/Soroban",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "jest --testPathIgnorePatterns='tests/integration'",
    "test:integration": "jest --testPathPattern='tests/integration'",
    "test:lint": "eslint src --ext .ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.3",
    "typescript": "5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/integration/"
    ]
  }
}
