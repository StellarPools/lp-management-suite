# LP Management Suite — environment variables
# Copy to .env and fill in real values.
# Used by the example CLI, keeper service, and integration tests.

# ─── Core ────────────────────────────────────────────────────────────────────

# Deployed aggregator contract ID
LP_SUITE_CONTRACT_ID=CA...

# Target network (testnet | futurenet | mainnet)
LP_SUITE_NETWORK=testnet

# Soroban RPC endpoint
LP_SUITE_RPC_URL=https://soroban-testnet.stellar.org

# ─── Keeper service (keeper/ only) ───────────────────────────────────────────

# Keeper's Stellar account public key (pays tx fees for compound() calls)
LP_SUITE_KEEPER_ACCOUNT=G...

# Keeper's Stellar account secret key — NEVER commit a real value
LP_SUITE_KEEPER_PRIVATE_KEY=S...

# Keeper poll interval in milliseconds (default: 300000 = 5 minutes)
LP_SUITE_KEEPER_POLL_INTERVAL_MS=300000

# Optional: webhook URL for health alert forwarding
LP_SUITE_ALERT_WEBHOOK=

# ─── Integration tests (sdk/tests/integration only) ──────────────────────────

# Testnet account for integration tests
LP_SUITE_TESTNET_PUBLIC_KEY=G...
LP_SUITE_TESTNET_SECRET_KEY=S...

# Pool IDs to use in integration tests
LP_SUITE_TEST_POOL_ID=pool-a
LP_SUITE_TEST_POOL_A=pool-a
LP_SUITE_TEST_POOL_B=pool-b

# ─── Logging ─────────────────────────────────────────────────────────────────

LP_SUITE_LOG_LEVEL=info
